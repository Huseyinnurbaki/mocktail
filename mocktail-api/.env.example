# Mocktail Backend Configuration
#
# Copy this file to .env IN THIS DIRECTORY (mocktail-api/) and edit it — the Go backend
# loads it automatically on startup (godotenv). Your real .env is gitignored; this template
# is committed.
#
#   cd mocktail-api
#   cp .env.example .env
#   # edit .env, then run from the repo root:  make dev-api
#
# For Docker, pass these with -e flags or the docker-compose `environment:` block instead.

# ============================================
# Server
# ============================================

# Port to listen on.
# Default: 6625 (Mocktail's signature port — "MOCK" on a phone keypad).
# Set to "auto" (or "0") to auto-select: prefer 6625, scan 6626-6634, then any free port
# (useful for the desktop app, which can't resolve a port clash from a terminal).
#
# MOCKTAIL_PORT=6625

# Path to the SQLite database file.
# Default: the OS per-user app-data dir (e.g. ~/Library/Application Support/mocktail/apis.db),
# so the DB survives updates and isn't tied to the working directory.
# For local dev, point it at the in-repo DB (this is what `make dev-api`/`run` set):
#
# MOCKTAIL_DB_PATH=db/apis.db

# ============================================
# CORS Configuration
# ============================================

# Allowed origins (comma-separated). Default: * (allow all)
#   MOCKTAIL_CORS_ORIGINS=https://myapp.com,http://localhost:3000
#
# MOCKTAIL_CORS_ORIGINS=*

# Allowed HTTP methods (comma-separated).
# Default: GET,POST,PUT,PATCH,DELETE,OPTIONS
#
# MOCKTAIL_CORS_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS

# Allowed headers (comma-separated). Default: * (allow all)
#   MOCKTAIL_CORS_HEADERS=Content-Type,Authorization,X-API-Key
#
# MOCKTAIL_CORS_HEADERS=*

# Allow credentials (cookies, authorization headers). Default: false
#
# ⚠️  IMPORTANT: Cannot use "*" for origins when credentials=true — you MUST specify
#     exact origins (comma-separated), e.g. MOCKTAIL_CORS_ORIGINS=https://myapp.com
#
# MOCKTAIL_CORS_CREDENTIALS=false

# ============================================
# API Key Authentication (Optional)
# ============================================

# Protect mock endpoints with an API key. If set, all requests to /mocktail/* must include it
# (header `X-API-Key: your-secret-key` or query `?api_key=your-secret-key`). The dashboard and
# Core API (/core/v1/*) are exempt. If not set, mock endpoints are open.
#
# MOCKTAIL_API_KEY=

# ============================================
# Admin (management API) Authentication (Optional)
# ============================================

# Protect the management/dashboard API (/core/v1/*) — separate from MOCKTAIL_API_KEY (which
# guards mock *consumers*). Gates the AI endpoints too, since they cost real credits.
# Tri-state, like MOCKTAIL_PORT:
#   - unset      → auth OFF (core API open; default, backward-compatible)
#   - <value>    → auth ON with that key; dashboard/MCP must send `X-Admin-Key: <value>`
#   - auto       → auth ON with a random key generated each launch (printed as a ready URL:
#                  http://localhost:6625/#admin_key=<token> — the token rides the URL fragment)
# `/` (static app) and `/health` always stay open so the app loads and the status pill polls.
#
# MOCKTAIL_ADMIN_KEY=

# ============================================
# AI Assistant (Optional)
# ============================================

# The API key is a BACKEND secret — it is never sent to or stored by the browser, and all
# provider calls are server-side. On desktop/CLI a key entered in Settings is stored in the OS
# keychain (macOS Keychain / Windows Credential Manager / Linux Secret Service), or a 0600 file
# on headless Linux. In containers, set the key here (env wins and makes the Settings field
# read-only).
#
# There is intentionally NO env var to select the provider — that's a Settings dropdown
# (data-driven from the backend), not an environment variable.

# Provider API key (containers). On desktop, prefer entering it in Settings (keychain) instead.
#
# MOCKTAIL_AI_API_KEY=

# Optional: pin a model id for reproducible deploys. If unset, the model chosen in Settings is
# used, else the provider's recommended default.
#
# MOCKTAIL_AI_MODEL=

# ============================================
# Frontend Configuration
# ============================================

# Override the Mocktail URL displayed in the dashboard (reverse proxy / custom domain).
#   MOCKTAIL_BASE_URL=https://api.mycompany.com/mocktail
#
# If not set, defaults to:
# - Development: http://localhost:6625/mocktail
# - Production:  [your-domain]/mocktail
#
# MOCKTAIL_BASE_URL=
